   "source": [
    "import pandas as pd\n",
    "\n",
    "df = pd.read_csv(\"datasets/ETT-data/ETTh1_labeled.csv\")\n",
    "\n",
    "zeros = df.iloc[:, -1].eq(0).sum()\n",
    "ones = df.iloc[:, -1].eq(1).sum()\n",
    "total = len(df)\n",
    "print(total)\n",
    "print(ones)\n",
    "red = (ones / total) * 100\n",
    "print(\"% of extreme events:\", red)\n",
    "\n"
   ],
